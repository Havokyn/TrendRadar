# TrendRadar - Git Ignore File
# Prevents accidentally committing sensitive data and generated files

# === CRITICAL: Configuration Files with Secrets ===
config/config.yaml
config/frequency_words.txt
.env
.env.local

# Keep example configs for reference
!config/config.example.yaml
!config/frequency_words.example.txt

# === Output Data ===
output/
output/**/*.txt
output/**/*.json
output/**/*.html

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
*.cover
*.log

# === Virtual Environments ===
venv/
ENV/
env/
.venv

# === UV Package Manager ===
.uv/
uv.lock

# === IDEs ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# === Docker ===
docker-compose.override.yml
.dockerignore

# === Temporary Files ===
*.tmp
*.bak
*.cache
.cache/

# === Push Records (if using push window feature) ===
push_records.json

# === System Files ===
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
